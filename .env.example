# grok2api + Litestream 配置
#
# 用法：
#   cp .env.example .env   然后填写下面的值
#
# 三种加载方式（任选）：
#   本地      docker run --env-file .env ...
#   平台 A    把整个文件内容粘到 ENV_FILE_CONTENT 变量里
#   平台 B    作为 secret file 挂到 /etc/secrets/.env
#
# 环境变量优先于本文件，平台注入的 PORT 不会被覆盖。

# ═══════════════════════════════════════════════════
#  必填
# ═══════════════════════════════════════════════════

# 主密钥。所有密钥由它派生。
# 生成：head -c 32 /dev/urandom | base64 | tr -d '/+='
#
# ⚠ 丢失或更改 = 数据库中已保存的账号凭据全部无法解密。
#   请存入密码管理器，并与对象存储一并备份。
MASTER_KEY=

# 对象存储位置。前缀（这里是 grok2api）可自定义。
LITESTREAM_REPLICA_URL=s3://your-bucket-name/grok2api

# 对象存储凭据
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# S3 端点。使用 AWS 官方 S3 时删掉此行。
#   Backblaze B2      https://s3.us-west-004.backblazeb2.com
#   Cloudflare R2     https://<account-id>.r2.cloudflarestorage.com
#   MinIO 自建        http://minio:9000
AWS_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com


# ═══════════════════════════════════════════════════
#  可选
# ═══════════════════════════════════════════════════

# 监听端口。多数平台自动注入，一般无需设置。
#PORT=8000

# 初始管理员。不设密码则由 MASTER_KEY 派生并在启动日志打印。
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=

# Cookie 的 Secure 标志。默认 true（HTTPS）。
# 仅在本地用 http:// 测试时设为 false，否则浏览器不回传 cookie。
#SECURE_COOKIES=true

# 审计日志留存天数。审计表会进入复制流，调大会增加库体积与流量。
#AUDIT_RETENTION_DAYS=2

# 完整 config.yaml 内容。设置后完全覆盖自动生成的配置，
# 需要深度定制上游参数时才用。
#CONFIG_CONTENT=
